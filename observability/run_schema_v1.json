{
  "schema_version": "run-v1",
  "required_fields": ["run_id","timestamp_utc","session_id","user_message","language","status","metadata","metrics","errors"],
  "status_values": ["started","success","failed"],
  "metadata_fields": [
    "application_version",
    "model",
    "embedding_model",
    "pinecone_index",
    "prompt_version",
    "retrieval_k",
    "temperature",
    "max_tokens"
  ],
  "metric_groups": ["dialogue","retrieval","classification","generation","voice"],
  "metric_fields": ["total_latency_ms","generation.token_usage.prompt_tokens","generation.token_usage.completion_tokens","generation.token_usage.total_tokens"]
}
