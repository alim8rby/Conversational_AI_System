OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
MEMORY_STORE_PATH=data/memory.json
PORT=8000

# Observability: keep false unless raw inputs are explicitly required for local debugging
OBSERVABILITY_STORE_INPUT=false
APP_VERSION=unknown
PROMPT_VERSION=v1
CORS_ORIGINS=http://localhost:8000

# Stateful session runtime: keep at 1 until external session/state storage is introduced
WEB_CONCURRENCY=1
WEB_THREADS=4
WEB_TIMEOUT=120
WEB_GRACEFUL_TIMEOUT=30
WEB_KEEPALIVE=5
