# Model runtime
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text

# Application
MEMORY_STORE_PATH=data/memory.json
DOMAIN_CONFIG_PATH=domains/demo_ecommerce/domain.json
PORT=8000
TOOL_TIMEOUT_SECONDS=5

# Observability
OBSERVABILITY_STORE_INPUT=false
OBSERVABILITY_RUNS_DIR=observability/runs
OBSERVABILITY_FAILURES_DIR=observability/failures
APP_VERSION=unknown
PROMPT_VERSION=v1

# Browser/API
CORS_ORIGINS=http://localhost:8000

# Stateful runtime: keep one Gunicorn worker until session state is externalized.
WEB_CONCURRENCY=1
WEB_THREADS=4
WEB_TIMEOUT=120
WEB_GRACEFUL_TIMEOUT=30
WEB_KEEPALIVE=5

# Docker Desktop: override OLLAMA_BASE_URL to http://host.docker.internal:11434
